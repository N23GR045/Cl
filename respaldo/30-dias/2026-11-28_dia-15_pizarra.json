   },
   "c4": {
    "at": 4,
    "w": 340
   }
  },
  "rows": {
   "r1": {
    "at": 1,
    "c1": "Decisión",
    "c2": "Elegido",
    "c3": "Por qué",
    "c4": "Riesgo que abre"
   },
   "r2": {
    "at": 2,
    "c1": "Dónde viven los datos",
    "c2": "En el móvil (IndexedDB)",
    "c3": "Sin servidor no hay brecha central ni coste; funciona sin red",
    "c4": "Si pierdes el móvil, pierdes los datos → copia JSON"
   },
   "r3": {
    "at": 3,
    "c1": "Dinero",
    "c2": "Enteros en céntimos",
    "c3": "En JS 0,1 + 0,2 ≠ 0,3; el céntimo sobrante se reparte siempre igual",
    "c4": "Exige tests del reparto (Especialización, módulo 7)"
   },
   "r4": {
    "at": 4,
    "c1": "Empaquetado",
    "c2": "Capacitor 8 (minSdk 24, target 36)",
    "c3": "APK que abre sin conexión; target 36 es lo que pide Play desde el 31-08-2026",
    "c4": "Pasar a Capacitor 9 cuando se publique"
   },
   "r5": {
    "at": 5,
    "c1": "Build",
    "c2": "GitHub Actions + firma con Secrets",
    "c3": "Versiones reproducibles sin claves en el repo",
    "c4": "Perder el keystore impide actualizar encima"
   },
   "r6": {
    "at": 6,
    "c1": "Distribución",
    "c2": "APK en Releases, sin Play",
    "c3": "Gratis y directo para ti y tus amigos",
    "c4": "Verificación de desarrollador: hoy solo Brasil, Indonesia, Singapur y Tailandia; global en 2027"
   },
   "r7": {
    "at": 7,
    "c1": "Sincronización",
    "c2": "Ninguna por ahora",
    "c3": "Minimización de datos (RGPD art. 5.1.c y 25)",
    "c4": "Si se añade: login, RLS y cifrado de extremo a extremo"
   }
  },
  "fills": {
   "r2": {
    "c2": "purple"
   },
   "r6": {
    "c4": "peach"
   }
  }
 },
