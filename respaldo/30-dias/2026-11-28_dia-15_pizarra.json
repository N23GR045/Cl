  "text": "Decisiones de arquitectura",
  "size": "large"
 },
 "e34": {
  "type": "table",
  "x": 0,
  "y": 820,
  "cols": {
   "c1": {
    "at": 1,
    "w": 190
   },
   "c2": {
    "at": 2,
    "w": 250
   },
   "c3": {
