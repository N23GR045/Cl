---
import type { Product } from "../data/catalog";
import { findCategory } from "../data/catalog";
import { site, formatPrice } from "../data/site";
import { t } from "../i18n/es";
interface Props { product: Product; eager?: boolean; headingLevel?: 2 | 3 }
const { product: p, eager = false, headingLevel = 3 } = Astro.props;
const cat = findCategory(p.cat)!;
const H = `h${headingLevel}` as "h2" | "h3";
---
<article class="card" data-product={p.id} data-cat={p.cat} data-price={p.price} data-name={p.name} data-search={`${p.name} ${p.spec} ${cat.name} ${p.desc}`}>
  <div class="card__media">
    {p.badge && <span class="badge">{p.badge}</span>}
    <img src={`/img/${p.img}-360.webp`} srcset={`/img/${p.img}-360.webp 360w, /img/${p.img}.webp 720w`} sizes="(min-width: 1080px) 290px, (min-width: 820px) 31vw, 48vw"
      width="360" height="295" alt={p.alt} loading={eager ? "eager" : "lazy"} decoding="async" />
  </div>
  <div class="card__body">
    <span class="card__cat">{cat.name}</span>
    <H class="card__title"><a href={`/productos/${p.id}`}>{p.name}</a></H>
    <span class="card__spec">{p.spec}</span>
    {p.price >= site.shipping.freeFrom && <span class="card__ship">Envío gratis</span>}
    <div class="card__foot">
      <span class="price">{formatPrice(p.price)}{p.old && <s><span class="sr-only">Antes </span>{formatPrice(p.old)}</s>}</span>
      <button type="button" class="btn btn--sm card__add" data-add={p.id} aria-label={`${t.cart.add}: ${p.name}`}>Añadir</button>
    </div>
  </div>
</article>
